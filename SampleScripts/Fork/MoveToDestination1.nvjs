// @name Classify to destination 1
// @description 按面板模式将当前主图移动或复制到第 1 个目标文件夹。
// @shortCutKey 1

// fork 专用脚本读取持久化模式，并按当前目标文件夹顺序选择第 1 项。
if (nv.Config.Panels.IsDestinationFolderCopyMode) {
    nv.Command.CopyToFolderAs.Patch({"Index": 1, "MultiPagePolicy": "Once"}).Execute()
} else {
    nv.Command.MoveToFolderAs.Patch({"Index": 1, "MultiPagePolicy": "Once"}).Execute()
}
