// @name Classify to destination 7
// @description 按面板模式将当前主图移动或复制到第 7 个目标文件夹。
// @shortCutKey 7

// fork 专用脚本读取持久化模式，并按当前目标文件夹顺序选择第 7 项。
if (nv.Config.Panels.IsDestinationFolderCopyMode) {
    nv.Command.CopyToFolderAs.Patch({"Index": 7, "MultiPagePolicy": "Once"}).Execute()
} else {
    nv.Command.MoveToFolderAs.Patch({"Index": 7, "MultiPagePolicy": "Once"}).Execute()
}
