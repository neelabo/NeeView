// @name Classify to destination 5
// @description 按面板模式将当前主图移动或复制到第 5 个目标文件夹。
// @shortCutKey 5

// fork 专用脚本读取持久化模式，并按当前目标文件夹顺序选择第 5 项。
if (nv.Config.Panels.IsDestinationFolderCopyMode) {
    nv.Command.CopyToFolderAs.Patch({"Index": 5, "MultiPagePolicy": "Once"}).Execute()
} else {
    nv.Command.MoveToFolderAs.Patch({"Index": 5, "MultiPagePolicy": "Once"}).Execute()
}
